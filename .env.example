APP_NAME="FeridhooTours"
APP_ENV=production
APP_KEY=base64:RenderGeneratedAppKeyHere=
APP_DEBUG=false
APP_URL=https://feridhootours.onrender.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
# Neon PostgreSQL Connection String provided in Render environment variables:
# DATABASE_URL=postgres://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DB_HOST=ep-xyz.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.smartferry.mv
MAIL_PORT=587
MAIL_USERNAME=notifications@smartferry.mv
MAIL_PASSWORD=secret
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@smartferry.mv"
MAIL_FROM_NAME="${APP_NAME}"
